<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the learner's own data (saved words, review schedule, settings) in the
     automatic device backup. The (large, replaceable) dictionary database is
     excluded so backups stay small. -->
<full-backup-content>
    <include
        domain="database"
        path="proudvocab.db" />
    <include
        domain="sharedpref"
        path="." />
    <include
        domain="file"
        path="datastore" />
    <include
        domain="file"
        path="fonts" />
    <exclude
        domain="file"
        path="dictionary" />
</full-backup-content>
